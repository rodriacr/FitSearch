# Los archivos que se ejecutan dentro de contenedores Linux deben quedar con saltos de línea LF,
# también al clonar en Windows (FS-HU-11).
*.sh            text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
.dockerignore   text eol=lf
.env.example    text eol=lf
