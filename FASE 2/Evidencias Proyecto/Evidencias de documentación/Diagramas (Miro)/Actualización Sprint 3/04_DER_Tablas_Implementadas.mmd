erDiagram
  roles ||--o{ usuarios : "rol_id (RESTRICT)"
  usuarios ||--o| perfiles_usuario : "usuario_id (CASCADE)"
  usuarios ||--o| informacion_salud : "usuario_id (CASCADE)"
  usuarios ||--o{ tokens_recuperacion : "usuario_id (CASCADE)"
  usuarios ||--o| profesionales : "usuario_id (CASCADE)"
  establecimientos |o--o{ profesionales : "establecimiento_id (SET NULL)"
  usuarios ||--o{ favoritos : "usuario_id (CASCADE)"
  profesionales ||--o{ favoritos : "profesional_id (CASCADE)"
  usuarios ||--o{ resenas : "usuario_id (CASCADE)"
  profesionales ||--o{ resenas : "profesional_id (CASCADE)"
  roles {
    INT id PK
    VARCHAR30 nombre UK "usuario, profesional, administrador"
  }
  usuarios {
    INT id PK
    VARCHAR100 nombre
    VARCHAR150 correo UK
    VARCHAR255 password_hash "NULL"
    VARCHAR255 google_id UK "NULL"
    INT rol_id FK
    BOOLEAN activo "DEFAULT true"
    INT version_sesion "DEFAULT 0"
    BOOLEAN rol_confirmado
    DATETIME fecha_registro
  }
  perfiles_usuario {
    INT id PK
    INT usuario_id FK,UK
    DECIMAL peso_kg
    DECIMAL altura_cm
    INT edad
    VARCHAR20 sexo
    VARCHAR50 actividad_fisica
    VARCHAR30 objetivo_principal
    TINYINT comidas_dia
    VARCHAR20 horas_sueno
  }
  informacion_salud {
    INT id PK
    INT usuario_id FK,UK
    JSON condiciones_medicas
    BOOLEAN toma_medicamentos
    JSON medicamentos
    JSON alergias
    DATETIME fecha_actualizacion
  }
  tokens_recuperacion {
    INT id PK
    INT usuario_id FK
    CHAR64 token_hash UK
    DATETIME fecha_expiracion
    DATETIME fecha_uso
    DATETIME fecha_creacion
  }
  profesionales {
    INT id PK
    INT usuario_id FK,UK
    INT establecimiento_id FK "NULL"
    VARCHAR100 especialidad
    TEXT descripcion "NULL"
    BOOLEAN verificado
    VARCHAR20 estado_verificacion "sin_solicitud, pendiente, verificado, rechazado"
    VARCHAR500 motivo_rechazo "NULL"
    JSON historial_verificacion "NULL"
    INT revision_verificacion "DEFAULT 0"
    VARCHAR12 rut "NULL"
    VARCHAR20 telefono "NULL"
    DECIMAL ubicacion_lat
    DECIMAL ubicacion_lng
    VARCHAR80 comuna "NULL"
    VARCHAR150 direccion "NULL, SC-24"
    VARCHAR20 modalidad "presencial, online, ambas"
  }
  establecimientos {
    INT id PK
    VARCHAR150 nombre
    VARCHAR50 categoria
    VARCHAR255 direccion
    DECIMAL ubicacion_lat
    DECIMAL ubicacion_lng
  }
  favoritos {
    INT id PK
    INT usuario_id FK "UK con profesional_id"
    INT profesional_id FK
    DATETIME fecha_creacion
  }
  resenas {
    INT id PK
    INT usuario_id FK "UK con profesional_id"
    INT profesional_id FK
    TINYINT puntaje "1 a 5"
    VARCHAR500 comentario "NULL"
    DATETIME fecha_creacion
    DATETIME fecha_actualizacion
  }
  profesionales ||--o{ documentos_profesionales : "profesional_id (CASCADE)"
  documentos_profesionales {
    INT id PK
    INT profesional_id FK
    VARCHAR30 tipo
    VARCHAR150 nombre
    VARCHAR50 clave UK
    VARCHAR40 mime
    INT tamano
    DATETIME fecha_creacion
  }
  profesionales ||--o{ disponibilidades : "profesional_id (CASCADE)"
  disponibilidades ||--o{ reservas : "disponibilidad_id (RESTRICT)"
  usuarios ||--o{ reservas : "usuario_id (CASCADE)"
  usuarios ||--o{ conversaciones : "usuario_id (CASCADE)"
  conversaciones ||--o{ mensajes : "conversacion_id (CASCADE)"
  usuarios ||--o| uso_asistente : "usuario_id (CASCADE)"
  usuarios ||--o{ registro_comida : "usuario_id (CASCADE)"
  alimentos |o--o{ registro_comida : "alimento_id (SET NULL)"
  conversaciones {
    INT id PK
    INT usuario_id FK
    VARCHAR80 titulo
    BOOLEAN fijada "DEFAULT false"
    DATETIME fecha_inicio
    DATETIME fecha_actualizacion
  }
  mensajes {
    INT id PK
    INT conversacion_id FK
    VARCHAR20 remitente "usuario, asistente"
    TEXT contenido
    VARCHAR100 especialidad "NULL"
    JSON comidas_agregadas "NULL"
    DATETIME fecha
  }
  uso_asistente {
    INT usuario_id PK,FK
    DATE fecha
    SMALLINT mensajes
  }
  registro_comida {
    INT id PK
    INT usuario_id FK
    DATE fecha
    VARCHAR20 momento "desayuno a cena"
    INT alimento_id FK "NULL"
    VARCHAR255 descripcion_alimento
    DECIMAL gramos "1 a 2000"
    INT calorias
    DECIMAL proteinas_g
    DECIMAL carbohidratos_g
    DECIMAL grasas_g
    VARCHAR20 origen "manual, asistente"
    DATETIME fecha_creacion
  }
  alimentos {
    INT id PK
    VARCHAR80 nombre UK
    VARCHAR255 sinonimos
    DECIMAL calorias "por 100 g"
    DECIMAL proteinas_g "por 100 g"
    DECIMAL carbohidratos_g "por 100 g"
    DECIMAL grasas_g "por 100 g"
  }
  disponibilidades {
    INT id PK
    INT profesional_id FK
    DATE fecha
    TIME hora_inicio
    TIME hora_fin
    BOOLEAN retirado "DEFAULT false"
  }
  reservas {
    INT id PK
    INT usuario_id FK
    INT disponibilidad_id FK
    VARCHAR500 mensaje
    VARCHAR20 estado "pendiente, confirmada, cancelada"
    DATETIME fecha_creacion
  }
