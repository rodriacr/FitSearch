// Modelo de datos de FitSearch.
// Fuente: Documento de Arquitectura del Sistema (DAS), sección "Diccionario de datos".
// Sprint 1: roles, usuarios y perfiles_usuario.
// Sprint 2: google_id en usuarios (password_hash opcional) y tokens_recuperacion (FS-HU-15, FS-HU-16);
// objetivos y estilo de vida en perfiles_usuario (FS-HU-18) e informacion_salud (FS-HU-19).
// Sprint 3: comuna y modalidad en profesionales (FS-HU-22), favoritos (FS-HU-23) y resenas (FS-HU-24).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique @db.VarChar(30)
  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id                 Int                 @id @default(autoincrement())
  nombre             String              @db.VarChar(100)
  correo             String              @unique @db.VarChar(150)
  passwordHash       String?             @map("password_hash") @db.VarChar(255)
  googleId           String?             @unique @map("google_id") @db.VarChar(255)
  rolId              Int                 @map("rol_id")
  // El registro crea toda cuenta como "usuario"; queda en true cuando la persona elige su tipo de cuenta
  // en el primer paso del asistente de perfil (FS-HU-02).
  rolConfirmado      Boolean             @default(false) @map("rol_confirmado")
  fechaRegistro      DateTime            @default(now()) @map("fecha_registro") @db.DateTime(0)
  activo             Boolean             @default(true)
  versionSesion      Int                 @default(0) @map("version_sesion")
  rol                Rol                 @relation(fields: [rolId], references: [id], onDelete: Restrict)
  perfil             PerfilUsuario?
  tokensRecuperacion TokenRecuperacion[]
  informacionSalud   InformacionSalud?
  profesional        Profesional?
  favoritos          Favorito[]
  resenas            Resena[]
  reservas           Reserva[]
  conversaciones     Conversacion[]
  usoAsistente       UsoAsistente?
  registrosComida    RegistroComida[]

  @@index([rolId])
  @@map("usuarios")
}

// FS-HU-03: directorio según el diccionario de datos del DAS.
// FS-HU-22: comuna y modalidad de atención (presencial, online o ambas; catálogo en shared/reglas.json).
model Profesional {
  id                    Int                    @id @default(autoincrement())
  usuarioId             Int                    @unique @map("usuario_id")
  establecimientoId     Int?                   @map("establecimiento_id")
  especialidad          String                 @db.VarChar(100)
  descripcion           String?                @db.Text
  verificado            Boolean                @default(false)
  estadoVerificacion    String                 @default("sin_solicitud") @map("estado_verificacion") @db.VarChar(20)
  motivoRechazo         String?                @map("motivo_rechazo") @db.VarChar(500)
  historialVerificacion Json?                  @map("historial_verificacion")
  revisionVerificacion  Int                    @default(0) @map("revision_verificacion")
  rut                   String?                @db.VarChar(12)
  telefono              String?                @db.VarChar(20)
  ubicacionLat          Decimal                @map("ubicacion_lat") @db.Decimal(10, 7)
  ubicacionLng          Decimal                @map("ubicacion_lng") @db.Decimal(10, 7)
  comuna                String?                @db.VarChar(80)
  // Dirección de atención propia (SC-24): obligatoria si atiende presencial o de ambas formas; opcional si atiende solo online.
  direccion             String?                @db.VarChar(150)
  modalidad             String                 @default("presencial") @db.VarChar(20)
  usuario               Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  establecimiento       Establecimiento?       @relation(fields: [establecimientoId], references: [id], onDelete: SetNull)
  favoritos             Favorito[]
  resenas               Resena[]
  documentos            DocumentoProfesional[]
  disponibilidades      Disponibilidad[]

  @@index([especialidad])
  @@index([comuna])
  @@map("profesionales")
}

model DocumentoProfesional {
  id            Int         @id @default(autoincrement())
  profesionalId Int         @map("profesional_id")
  tipo          String      @db.VarChar(30)
  nombre        String      @db.VarChar(150)
  clave         String      @unique @db.VarChar(50)
  mime          String      @db.VarChar(40)
  tamano        Int
  fechaCreacion DateTime    @default(now()) @map("fecha_creacion") @db.DateTime(0)
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)

  @@index([profesionalId])
  @@map("documentos_profesionales")
}

// FS-HU-13/14: horarios locales de America/Santiago y reservas privadas.
model Disponibilidad {
  id            Int         @id @default(autoincrement())
  profesionalId Int         @map("profesional_id")
  fecha         DateTime    @db.Date
  horaInicio    DateTime    @map("hora_inicio") @db.Time(0)
  horaFin       DateTime    @map("hora_fin") @db.Time(0)
  retirado      Boolean     @default(false)
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  reservas      Reserva[]

  @@index([profesionalId, fecha])
  @@map("disponibilidades")
}

model Reserva {
  id               Int            @id @default(autoincrement())
  usuarioId        Int            @map("usuario_id")
  disponibilidadId Int            @map("disponibilidad_id")
  mensaje          String         @db.VarChar(500)
  estado           String         @default("pendiente") @db.VarChar(20)
  fechaCreacion    DateTime       @default(now()) @map("fecha_creacion") @db.DateTime(0)
  usuario          Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  disponibilidad   Disponibilidad @relation(fields: [disponibilidadId], references: [id], onDelete: Restrict)

  @@index([disponibilidadId, estado])
  @@index([usuarioId])
  @@map("reservas")
}

// Conversaciones con el asistente IA (FS-HU-07, DAS D33). El historial vive dentro del asistente y su dueño puede
// fijarlas o borrarlas; se eliminan junto con la cuenta. fecha_actualizacion ordena el historial (cambia con cada mensaje).
model Conversacion {
  id                 Int       @id @default(autoincrement())
  usuarioId          Int       @map("usuario_id")
  titulo             String    @db.VarChar(80)
  fijada             Boolean   @default(false)
  fechaInicio        DateTime  @default(now()) @map("fecha_inicio") @db.DateTime(0)
  fechaActualizacion DateTime  @default(now()) @map("fecha_actualizacion") @db.DateTime(0)
  usuario            Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  mensajes           Mensaje[]

  @@index([usuarioId, fechaActualizacion])
  @@map("conversaciones")
}

// Mensajes de cada conversación. remitente: usuario o asistente (catálogo en shared/reglas.json).
model Mensaje {
  id               Int          @id @default(autoincrement())
  conversacionId   Int          @map("conversacion_id")
  remitente        String       @db.VarChar(20)
  contenido        String       @db.Text
  // FS-HU-08: especialidad del catálogo que el asistente recomendó en esta respuesta (solo mensajes del asistente).
  especialidad     String?      @db.VarChar(100)
  // FS-HU-09: alimentos que el asistente agregó a las comidas en esta respuesta ([{ id, nombre, gramos, calorias, momento }]).
  comidasAgregadas Json?        @map("comidas_agregadas")
  fecha            DateTime     @default(now()) @db.DateTime(0)
  conversacion     Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@index([conversacionId, fecha])
  @@map("mensajes")
}

// Mensajes que cada usuario envió al asistente en el día (límite diario, FS-HU-07). Una fila por usuario, sin contenido:
// borrar una conversación no devuelve el cupo. fecha es el día en Chile.
model UsoAsistente {
  usuarioId Int      @id @map("usuario_id")
  fecha     DateTime @db.Date
  mensajes  Int      @default(0) @db.SmallInt
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("uso_asistente")
}

// Catálogo de alimentos con su aporte por 100 g (FS-HU-09 y FS-HU-10). Se carga en la migración; valores de referencia
// aproximados de USDA FoodData Central. sinonimos: palabras de uso común separadas por coma.
model Alimento {
  id             Int              @id @default(autoincrement())
  nombre         String           @unique @db.VarChar(80)
  sinonimos      String           @default("") @db.VarChar(255)
  calorias       Decimal          @db.Decimal(6, 1)
  proteinasG     Decimal          @map("proteinas_g") @db.Decimal(5, 1)
  carbohidratosG Decimal          @map("carbohidratos_g") @db.Decimal(5, 1)
  grasasG        Decimal          @map("grasas_g") @db.Decimal(5, 1)
  registros      RegistroComida[]

  @@map("alimentos")
}

// Alimentos que cada usuario registró por día y momento (DAS, tabla registro_comida). El aporte se calcula al registrar
// y se guarda, para que el historial no cambie si se corrige el catálogo. origen: manual o asistente (catálogo en reglas).
model RegistroComida {
  id                  Int       @id @default(autoincrement())
  usuarioId           Int       @map("usuario_id")
  fecha               DateTime  @db.Date
  momento             String    @db.VarChar(20)
  alimentoId          Int?      @map("alimento_id")
  descripcionAlimento String    @map("descripcion_alimento") @db.VarChar(255)
  gramos              Decimal   @db.Decimal(6, 1)
  calorias            Int?
  proteinasG          Decimal?  @map("proteinas_g") @db.Decimal(6, 2)
  carbohidratosG      Decimal?  @map("carbohidratos_g") @db.Decimal(6, 2)
  grasasG             Decimal?  @map("grasas_g") @db.Decimal(6, 2)
  origen              String    @default("manual") @db.VarChar(20)
  fechaCreacion       DateTime  @default(now()) @map("fecha_creacion") @db.DateTime(0)
  usuario             Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  alimento            Alimento? @relation(fields: [alimentoId], references: [id], onDelete: SetNull)

  @@index([usuarioId, fecha])
  @@index([alimentoId])
  @@map("registro_comida")
}

// Profesionales que cada usuario guarda para volver a encontrarlos (FS-HU-23).
model Favorito {
  id            Int         @id @default(autoincrement())
  usuarioId     Int         @map("usuario_id")
  profesionalId Int         @map("profesional_id")
  fechaCreacion DateTime    @default(now()) @map("fecha_creacion") @db.DateTime(0)
  usuario       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, profesionalId])
  @@index([profesionalId])
  @@map("favoritos")
}

// Calificación de 1 a 5 estrellas con comentario opcional (FS-HU-24). Una por usuario y profesional;
// el promedio y la cantidad se calculan al consultar, sin columnas duplicadas en profesionales.
model Resena {
  id                 Int         @id @default(autoincrement())
  usuarioId          Int         @map("usuario_id")
  profesionalId      Int         @map("profesional_id")
  puntaje            Int         @db.TinyInt
  comentario         String?     @db.VarChar(500)
  fechaCreacion      DateTime    @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime    @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)
  usuario            Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  profesional        Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, profesionalId])
  @@index([profesionalId])
  @@map("resenas")
}

model Establecimiento {
  id            Int           @id @default(autoincrement())
  nombre        String        @db.VarChar(150)
  categoria     String        @db.VarChar(50)
  direccion     String        @db.VarChar(255)
  ubicacionLat  Decimal       @map("ubicacion_lat") @db.Decimal(10, 7)
  ubicacionLng  Decimal       @map("ubicacion_lng") @db.Decimal(10, 7)
  profesionales Profesional[]

  @@map("establecimientos")
}

model PerfilUsuario {
  id                Int      @id @default(autoincrement())
  usuarioId         Int      @unique @map("usuario_id")
  pesoKg            Decimal? @map("peso_kg") @db.Decimal(5, 2)
  alturaCm          Decimal? @map("altura_cm") @db.Decimal(5, 2)
  edad              Int?
  sexo              String?  @db.VarChar(20)
  actividadFisica   String?  @map("actividad_fisica") @db.VarChar(50)
  objetivoPrincipal String?  @map("objetivo_principal") @db.VarChar(30)
  comidasDia        Int?     @map("comidas_dia") @db.TinyInt
  horasSueno        String?  @map("horas_sueno") @db.VarChar(20)
  usuario           Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("perfiles_usuario")
}

// Códigos de un solo uso para restablecer la contraseña; solo se guarda el hash SHA-256 (DAS, QS6 y D16).
model TokenRecuperacion {
  id              Int       @id @default(autoincrement())
  usuarioId       Int       @map("usuario_id")
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  fechaExpiracion DateTime  @map("fecha_expiracion") @db.DateTime(0)
  fechaUso        DateTime? @map("fecha_uso") @db.DateTime(0)
  fechaCreacion   DateTime  @default(now()) @map("fecha_creacion") @db.DateTime(0)
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_recuperacion")
}

// Información de salud declarada por el usuario (FS-HU-19). Dato sensible: solo lo consulta su dueño (DAS, QS7).
// Las listas guardan valores de los catálogos de shared/reglas.json (sin texto libre, por minimización de datos).
model InformacionSalud {
  id                 Int      @id @default(autoincrement())
  usuarioId          Int      @unique @map("usuario_id")
  condicionesMedicas Json     @map("condiciones_medicas")
  tomaMedicamentos   Boolean  @map("toma_medicamentos")
  medicamentos       Json
  alergias           Json
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)
  usuario            Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("informacion_salud")
}
