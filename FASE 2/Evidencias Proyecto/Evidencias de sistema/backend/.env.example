# Copiar este archivo como .env y completar los valores. Nunca subir .env al repositorio.

# Puerto de la API
PORT=3000

# Conexión a MySQL 8 (usuario y bases creados con prisma/crear_base_datos.sql)
DATABASE_URL="mysql://fitsearch:CAMBIAR_CONTRASENA@localhost:3306/fitsearch"
# Base auxiliar que Prisma usa para generar migraciones (solo desarrollo)
SHADOW_DATABASE_URL="mysql://fitsearch:CAMBIAR_CONTRASENA@localhost:3306/fitsearch_shadow"

# Autenticación
JWT_SECRET="reemplazar-por-una-cadena-larga-y-aleatoria"
JWT_EXPIRES_IN=8h
BCRYPT_COST=10
# Duración de la sesión cuando se marca "Recordarme"
JWT_REMEMBER_EXPIRES_IN=30d

# Recuperación de contraseña (FS-HU-15)
FRONTEND_URL=http://localhost:5173
RECOVERY_TOKEN_MINUTES=60
# Correo de envío (Gmail con contraseña de aplicación). Mientras SMTP_CONTRASENA diga CAMBIAR o esté vacía,
# el enlace de recuperación se muestra en la consola del backend en vez de enviarse.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USUARIO=
SMTP_CONTRASENA=CAMBIAR
SMTP_REMITENTE="FitSearch <correo-del-proyecto@gmail.com>"


# Inicio de sesión con Google (FS-HU-16). ID de cliente OAuth tipo "Aplicación web" de Google Cloud Console.
# No es secreto (el navegador lo ve), pero debe ser el mismo que VITE_GOOGLE_CLIENT_ID del frontend.
# Sin este valor el botón "Continuar con Google" aparece desactivado.
GOOGLE_CLIENT_ID=
# Asistente IA (FS-HU-07, DAS D33). Cualquier proveedor compatible con la API de OpenAI; por defecto Groq en su plan
# gratuito (crear la clave en https://console.groq.com/keys). Sin IA_API_KEY el asistente responde en modo simulado.
IA_URL_BASE=https://api.groq.com/openai/v1
IA_MODELO=llama-3.3-70b-versatile
IA_API_KEY=
# Mensajes que cada usuario puede enviar por día (se reinicia a medianoche de Chile)
IA_MENSAJES_POR_DIA=30
# Documentos privados de verificación: directorio persistente fuera del frontend y de Git.
# Si se omite, se usa backend/storage/verificaciones.
VERIFICATION_STORAGE_DIR=
