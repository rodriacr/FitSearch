# Variables de docker-compose.yml (FS-HU-11). Copiar como .env en esta misma carpeta y completar.
# Nunca subir .env al repositorio. Para desarrollo sin Docker se sigue usando backend/.env.example.
#
# Las contraseñas forman parte de DATABASE_URL: usar solo letras y números (sin @ : / ? #).
# Para generar valores aleatorios:  openssl rand -hex 16  (contraseñas)  y  openssl rand -hex 48  (JWT_SECRET)

# Obligatorias
MYSQL_ROOT_PASSWORD=CAMBIAR
MYSQL_PASSWORD=CAMBIAR
JWT_SECRET=CAMBIAR

# Puertos publicados en el equipo (opcional)
PUERTO_WEB=8080
PUERTO_API=3000
# Dirección con que se abre la web; se usa en el enlace de recuperación de contraseña
FRONTEND_URL=http://localhost:8080

# Sesión (opcional)
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=30d
BCRYPT_COST=10
RECOVERY_TOKEN_MINUTES=60

# Correo (opcional). Mientras SMTP_CONTRASENA diga CAMBIAR o esté vacía, los enlaces se muestran en el log del backend:
#   docker compose logs backend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USUARIO=
SMTP_CONTRASENA=CAMBIAR
SMTP_REMITENTE=

# Inicio de sesión con Google (opcional, FS-HU-16). Se usa en el backend y en el build del frontend;
# si se cambia, reconstruir con: docker compose up --build
GOOGLE_CLIENT_ID=

# Asistente IA (opcional, FS-HU-07). Sin IA_API_KEY responde en modo simulado.
IA_URL_BASE=https://api.groq.com/openai/v1
IA_MODELO=openai/gpt-oss-120b
IA_API_KEY=
IA_MENSAJES_POR_DIA=30
