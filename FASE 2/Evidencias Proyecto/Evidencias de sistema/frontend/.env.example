# Copiar como .env para activar "Continuar con Google" (FS-HU-16). Sin esta variable el botón aparece desactivado.
# ID de cliente OAuth tipo "Aplicación web" creado en Google Cloud Console (no es secreto).
VITE_GOOGLE_CLIENT_ID=

# Google Maps JavaScript API (FS-HU-06). Restringir la clave por dominio y API.
# Sin clave, la vista Mapa conserva el listado y muestra cómo volver a intentarlo.
VITE_GOOGLE_MAPS_API_KEY=
# ID de mapa para marcadores avanzados. DEMO_MAP_ID sirve para desarrollo.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
